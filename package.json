{
  "name": "llm-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "index": "node scripts/build-search-index.mjs",
    "predev": "npm run index",
    "dev": "vite",
    "prebuild": "npm run index && npm run sources:check",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sources:check": "node scripts/check-sources.mjs",
    "history": "node scripts/update-history.mjs",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "sources:report": "node scripts/sources-report.mjs",
    "freshness": "node scripts/freshness.mjs",
    "freshness:links": "node scripts/freshness.mjs --links"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@playwright/test": "^1.64.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "node-html-parser": "^9.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "zod": "^4.6.5"
  }
}
